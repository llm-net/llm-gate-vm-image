# LLM Gate VM guest 内核配置片段：叠在 Firecracker v1.17.0 的 microvm-kernel-ci-x86_64-6.18.config 之后，
# 再经 `make olddefconfig` 解依赖。这里的每一行都必须在最终 .config 里原样成立（build.sh 逐行核对，依赖没
# 满足而被 olddefconfig 丢掉就让构建失败）。全部编进内核（=y），镜像不带模块。

# Ctrl+Alt+Del：vmd 的「管理员停止」经 Firecracker 的 SendCtrlAltDel 让 guest 走重启流程退出，需要 i8042 与
# AT 键盘驱动（Firecracker 的 ci.config 与 docs/api_requests/actions.md）。
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# 在线扩容：guest 每次启动对已挂载的系统盘与数据盘跑 resize2fs。Ubuntu 24.04 的 e2fsprogs 1.47.0 做在线扩容时也以读写
# 方式打开块设备，官方配置关掉的这一项（上游缺省为 y）会让它报 EBUSY。
CONFIG_BLK_DEV_WRITE_MOUNTED=y

# /proc/config.gz：Docker 与 k3s 的 check-config 读它核对内核能力。
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# k3s / kube-proxy（iptables 模式）用到的 xtables 匹配。
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

# ipset：kube-proxy 的 ipvs 模式与 k3s 内置网络策略控制器（kube-router）用到的集合类型，
# 以及 iptables 的 `-m set` 匹配。
CONFIG_IP_SET=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y

# IPVS：kube-proxy 的 ipvs 模式（启动时核对 rr / wrr / sh 三种调度器与连接跟踪），以及 `-m ipvs` 匹配。
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y

# k3s 内置网络策略控制器（kube-router）：桥上流量的 physdev 匹配，被拒流量按限速写 NFLOG。
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# 时间同步：chrony 以 KVM PTP 时钟（/dev/ptp_kvm，宿主时钟）为 refclock。
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_KVM=y
